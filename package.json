{
  "name": "n8n-nodes-coinbase-cdp",
  "version": "0.1.0",
  "description": "n8n community node for Coinbase Developer Platform (CDP) - wallets, transfers, swaps, and AI agent tools",
  "keywords": [
    "n8n-community-node-package",
    "coinbase",
    "cdp",
    "blockchain",
    "crypto",
    "wallet",
    "web3",
    "ai-agent"
  ],
  "license": "MIT",
  "author": {
    "name": "pvdyck"
  },
  "homepage": "https://github.com/pvdyck/n8n-nodes-coinbase-cdp#readme",
  "bugs": {
    "url": "https://github.com/pvdyck/n8n-nodes-coinbase-cdp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pvdyck/n8n-nodes-coinbase-cdp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "n8n-node dev",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "npx ts-node test/e2e/run-workflows.ts",
    "test:all": "jest --coverage && npx ts-node test/e2e/run-workflows.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CoinbaseCdpApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CoinbaseAgentTool/CoinbaseAgentTool.node.js",
      "dist/nodes/CoinbaseCdp/CoinbaseCdp.node.js",
      "dist/nodes/CoinbaseTrigger/CoinbaseTrigger.node.js"
    ]
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.44.0",
    "@langchain/core": "^0.3.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.19.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  }
}
